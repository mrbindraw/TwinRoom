# TwinRoom secrets - COPY THIS FILE TO ".env" AND FILL IN YOUR OWN VALUES.
# The real ".env" file is git-ignored and must never be committed.

# Publisher identity (the simulated sensor)
SENSOR_USERNAME=sensor
SENSOR_PASSWORD=change-me-sensor

# Subscriber identity (the UE5 digital twin)
TWIN_USERNAME=twin
TWIN_PASSWORD=change-me-twin

# Broker connection
MQTT_BROKER=localhost
MQTT_PORT=8883
